# Publieke instellingen (geen geheimen). Pas aan zodra de site naar het eigen domein verhuist.

# Volledige URL waarop de site staat — gebruikt voor de deel-afbeelding (Open Graph).
VITE_SITE_URL=https://ghostyfied.github.io/vocal-group-utrecht

# "noindex" zolang dit een concept is, zodat Google de testversie niet indexeert.
# Zet op "index, follow" bij livegang.
VITE_ROBOTS=noindex
